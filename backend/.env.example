# ============================================================
# MUKURTHAM MATRIMONY - Backend Configuration
# ============================================================
# Copy this file to .env and fill in your values

# Server Configuration
PORT=8000
NODE_ENV=development

# Database Configuration
# For local development with Docker Compose:
DATABASE_URL="mysql://mukurtham_user:mukurtham_password@localhost:3306/mukurtham_matrimony"

# For production, update with your database credentials
# DATABASE_URL="mysql://user:password@your-db-host:3306/mukurtham_matrimony"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# CORS Configuration - Add your frontend URLs here
CLIENT_ORIGIN="http://localhost:3000,http://localhost:3000/"

# JWT Authentication Secrets
JWT_SECRET="super_secret_jwt_sign_key_9876543210!"
JWT_REFRESH_SECRET="super_secret_jwt_refresh_sign_key_0123456789!"

# ============================================================
# Third-Party Services
# ============================================================

# Cloudinary (Image Upload Service)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Email Configuration (Gmail SMTP)
NODEMAILER_HOST="smtp.gmail.com"
NODEMAILER_PORT=587
NODEMAILER_USER="your_gmail@gmail.com"
NODEMAILER_PASS="your_gmail_app_password"
NODEMAILER_FROM="your_gmail@gmail.com"

# Twilio (SMS Service)
TWILIO_ACCOUNT_SID="your_account_sid"
TWILIO_AUTH_TOKEN="your_auth_token"
TWILIO_PHONE_NUMBER="+14165550198"

# Stripe (Payment Processing)
STRIPE_SECRET_KEY="sk_live_your_stripe_key"
STRIPE_PUBLIC_KEY="pk_live_your_stripe_key"
