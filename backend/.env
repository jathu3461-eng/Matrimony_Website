#   3. Create an App Password for "Mail" → copy the 16-char code
#   4. Fill in the three values below — remove the leading # on each line
#NODEMAILER_HOST=smtp.gmail.com
#NODEMAILER_PORT=587
#NODEMAILER_USER=matrimony2026@gmail.com
#NODEMAILER_PASS=xxxx xxxx xxxx xxxx
