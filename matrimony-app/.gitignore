# ─── Dependencies ─────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Environment & Secrets (NEVER COMMIT) ─────
.env
.env.local
.env.production
.env.staging
backend/.env
frontend/.env

# ─── Build Output ─────────────────────────────
# frontend/dist/ is intentionally NOT ignored so cPanel can pull built files
frontend/.vite/
build/
.cache/

# ─── Database (SQLite local file) ─────────────
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal

# ─── Uploads (user-uploaded files) ────────────
backend/uploads/

# ─── Logs ─────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
logs/

# ─── OS Files ─────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDE ──────────────────────────────────────
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ─── PM2 ──────────────────────────────────────
.pm2/

# ─── Vercel ───────────────────────────────────
.vercel/
